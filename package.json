{
  "name": "@hanchn/dsh-vision-router",
  "version": "0.3.0",
  "description": "Zero-config multi-provider vision routing for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": ["deepseek-harness", "dsh-plugin", "vision", "multimodal", "ollama", "openai-compatible"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanchn/dsh-vision-router.git"
  },
  "homepage": "https://github.com/hanchn/dsh-vision-router#readme",
  "bugs": "https://github.com/hanchn/dsh-vision-router/issues",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/model-discovery.test.mjs test/real-tool-chain.test.mjs test/attachment-bridge.test.mjs",
    "check": "node --check src/index.js && npm test"
  }
}
